{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart Connect",
  "version": "0.1.1",
  "identifier": "com.stefcodes.smart-connect",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:export"
  },
  "app": {
    "windows": [
      {
        "title": "Smart Connect for Sennheiser",
        "url": "/app",
        "width": 1000,
        "height": 860,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}